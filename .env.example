# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit .env atau kunci asli.

DATABASE_URL=postgresql://pelita:pelita_dev_password@localhost:5432/pelita

# 32 byte base64. Buat dengan: npm run gen:keys
DATA_ENCRYPTION_KEY=
TICKET_PEPPER=
SESSION_SECRET=

EVIDENCE_DIR=./storage/evidence
MAX_UPLOAD_MB=10

# Diisi tim dengan koordinat kampus UNY.
CAMPUS_MAP_LAT=
CAMPUS_MAP_LNG=

# Hanya dipakai prisma/seed.ts. Ganti setelah login pertama.
SEED_SUPER_ADMIN_EMAIL=ISI_OLEH_TIM
SEED_SUPER_ADMIN_PASSWORD=ISI_OLEH_TIM
